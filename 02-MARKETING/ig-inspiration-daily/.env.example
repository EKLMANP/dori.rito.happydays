# IG 靈感日報 — 環境變數範本
# 複製此檔案為 .env 並填入你的 API keys

# Telegram Bot Token（從 @BotFather 建立新 Bot 取得）
IG_DAILY_TELEGRAM_BOT_TOKEN=

# Telegram Group Chat ID（將 Bot 加入群組後取得）
IG_DAILY_TELEGRAM_CHAT_ID=

# Anthropic Claude API Key（與其他 Bot 共用）
ANTHROPIC_API_KEY=

# Apify API Token（從 apify.com 免費帳號取得）
APIFY_API_TOKEN=

# Notion API Token（與其他 Bot 共用，需有 Eric/Pennee 代辦任務 DB 權限）
NOTION_API_TOKEN=

# 授權用戶 Telegram User IDs（逗號分隔，可選）
IG_DAILY_AUTHORIZED_USERS=
