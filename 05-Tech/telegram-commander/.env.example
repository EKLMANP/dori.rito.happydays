# Dori & Rito 虛擬團隊 — 環境變數範本
# 複製此檔為 .env 並填入實際值
# cp .env.example .env

# ── Telegram Bot ──────────────────────────
TELEGRAM_BOT_TOKEN=      # BotFather 取得
TELEGRAM_CHAT_ID=        # 你的個人 Chat ID

# ── Anthropic (DR_Virtual Team) ───────────
ANTHROPIC_API_KEY=       # console.anthropic.com

# ── Kit Newsletter Automation ─────────────
KIT_API_SECRET=          # kit.com → Settings → Advanced

# ── 排課系統 Google OAuth ────────────────
# 執行 scheduler/setup_google_oauth.py 取得以下三個值
GOOGLE_SCHEDULER_CLIENT_ID=       # Google Cloud Console OAuth Client ID
GOOGLE_SCHEDULER_CLIENT_SECRET=   # Google Cloud Console OAuth Client Secret
GOOGLE_SCHEDULER_REFRESH_TOKEN=   # setup_google_oauth.py 授權後取得

# ── 排課系統 Google Sheet ────────────────
GOOGLE_SHEET_ID=                  # 排課試算表 ID（URL 中 /d/ 和 /edit 之間的字串）
GOOGLE_SHEET_TAB_NAME=Sheet1      # 試算表分頁名稱
